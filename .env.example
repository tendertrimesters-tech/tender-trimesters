# ===========================================
# Tender Trimesters — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
#
# Generate a random secret with:
#   openssl rand -base64 32
# ===========================================

# --- Database ---
DATABASE_URL="file:./db/custom.db"                 # Dev: SQLite | Prod: PostgreSQL connection string

# --- Authentication (NextAuth) ---
NEXTAUTH_SECRET=""                                # REQUIRED: Generate with openssl rand -base64 32
NEXTAUTH_URL="https://tendertrimesters.com"       # REQUIRED: Your production URL (no trailing slash)

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=""                             # From Stripe Dashboard → Developers → API Keys
STRIPE_WEBHOOK_SECRET=""                         # From Stripe Dashboard → Developers → Webhooks
STRIPE_ONE_TIME_PRICE_ID=""                      # From Stripe Dashboard → Products → One-time price ID
STRIPE_MONTHLY_PRICE_ID=""                       # From Stripe Dashboard → Products → Monthly price ID
NEXT_PUBLIC_STRIPE_CONFIGURED="0"                # Set to "1" to enable live Stripe checkout

# --- AI (Tempie, Letters from Baby, Fear to Flame, DreamKeeper) ---
ZAI_API_KEY=""                                   # z-ai-web-dev-sdk API key
