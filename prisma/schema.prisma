// Tender Trimesters — Prisma schema
//
// PRODUCTION MIGRATION CHECKLIST:
//   1. Change provider below to "postgresql"
//   2. Set DATABASE_URL to your Postgres connection string:
//      postgresql://user:password@host:5432/dbname?schema=public
//   3. Run: npx prisma migrate dev --name init
//   4. Run: npx prisma generate
//
// SQLite works great for local dev. Do NOT use SQLite in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  // Pregnancy profile
  dueDate        DateTime?
  babyName       String?
  partnerName    String?
  // Premium
  isPremium      Boolean  @default(false)
  premiumTier    String?  // "one_time" | "monthly"
  premiumSince   DateTime?
  // Stripe (set by webhook after successful checkout)
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  stripeCheckoutSessionId String? @unique
  // Onboarding
  onboarded      Boolean  @default(false)
  // Partner link (so a partner can view their journey read-only)
  partnerLinkToken String? @unique
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntries  JournalEntry[]
  moodEntries     MoodEntry[]
  appointments    Appointment[]
  bumpPhotos      BumpPhoto[]
  chatMessages    ChatMessage[]
  communityPosts  CommunityPost[]
  communityComments CommunityComment[]
  meditationSessions MeditationSession[]
  waitlistEntry   WaitlistEntry?
  // NEW: Sacred features
  ritualLogs      RitualLog[]
  maternalStories  MaternalStory[]
  fearEntries     FearEntry[]
  babyLetters     BabyLetter[]
  dreamEntries    DreamEntry[]
  nameSeeds       NameSeed[]
  capsuleItems    CapsuleItem[]
  playlistTracks  PlaylistTrack[]
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  // "landing_hero" | "landing_cta" | etc.
  userId    String?  @unique // link to user if they sign up later
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int?     // pregnancy week 1-40
  title     String?
  body      String
  mood      String?  // "glowing" | "calm" | "tired" | "anxious" | "teary" | "grateful"
  craving   String?
  babyName   String?
  photoUrl  String?
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String   // "glowing" | "calm" | "tired" | "anxious" | "teary" | "grateful" | "nauseous" | "energized"
  note      String?
  week      Int?
  createdAt DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  location    String?
  notes       String?
  type        String?  // "ob_visit" | "ultrasound" | "glucose_test" | "lab" | "other"
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BumpPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int
  photoUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  mood      String?
  week      Int?
  hugs      Int      @default(0)
  createdAt DateTime @default(now())
  comments  CommunityComment[]
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// Static weekly pregnancy content (seeded, not user-editable)
model WeeklyContent {
  id              String   @id @default(cuid())
  week            Int      @unique // 1-40
  trimester       Int      // 1, 2, or 3
  babySize        String   // "Lime"
  babySizeDesc    String   // "About 2 inches long..."
  babyLengthCm    Float
  babyWeightG     Float
  bodyChanges     String   // multi-line, separated by \n
  emotionalChanges String
  bestFriendTip   String
  selfCare        String   // checklist items separated by \n
  affirmation     String
  milestone       String?  // optional special milestone
  createdAt       DateTime @default(now())
}

model MeditationSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meditationId String   // matches meditations.ts id field
  durationSec  Int      // actual seconds listened
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model RitualLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int
  phrase    String   // the ritual phrase used
  gesture   String   // the gesture described
  breath    String   // the breath cue
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MaternalStory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptIndex Int    // which of the 12 prompts (0-11)
  response  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FearEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fear        String   // the original fear
  reframed    String?  // AI-reframed courage
  action      String?  // grounding action
  category    String?  // fear category (e.g. "Birth", "Body", "Relationship")
  stage       String   @default("ember") // "ember" | "spark" | "flame"
  week        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BabyLetter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int      // pregnancy week
  letter    String   // the AI-generated letter in baby's voice
  createdAt DateTime @default(now())
}

model DreamEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  body        String   // the dream description
  mood        String?  // mood the user selected (e.g. "peaceful", "anxious", "vivid")
  symbols     String?  // AI-extracted recurring symbols (JSON array)
  themes      String?  // AI-extracted themes (JSON array)
  interpretation String? // AI dream interpretation
  week        Int?
  createdAt   DateTime @default(now())
}

model NameSeed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  feeling   String?  // how the name feels to mama this week
  week      Int?     // when planted
  chosen    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapsuleItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "letter" | "wish" | "promise" | "photo"
  title       String
  body        String?
  unlockDate  DateTime? // when to reveal (defaults to due date)
  unlocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PlaylistTrack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase     String   // "early" | "active" | "pushing" | "first_cry" | "golden_hour"
  title     String
  artist    String?
  note      String?
  createdAt DateTime @default(now())
}
